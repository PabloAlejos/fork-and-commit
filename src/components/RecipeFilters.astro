---
// No props needed — filtering happens client-side
---

<div class="cmd-panel">

  <!-- Buscador -->
  <div class="search-line">
    <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <circle cx="9" cy="9" r="6" />
      <path d="M13.5 13.5L17 17" />
    </svg>
    <input
      type="text"
      id="search-input"
      class="search-input"
      placeholder="buscar receta o ingrediente"
      autocomplete="off"
      spellcheck="false"
      aria-label="Buscar receta o ingrediente"
    />
    <button id="clear-search" class="clear-search" aria-label="Limpiar búsqueda" style="display:none">
      <svg width="11" height="11" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Desplegar filtros -->
  <button id="filters-toggle" class="filters-toggle" aria-expanded="false">
    <span class="toggle-label">filtros</span>
    <svg class="toggle-chevron" width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true">
      <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Filas plegables -->
  <div id="filters-collapse" class="filters-collapse">
    <div class="filter-rows">

      <div class="filter-row" id="row-difficulty">
        <span class="flag">dificultad</span>
        <div class="pills" id="pills-difficulty">
          <button class="pill active" data-filter="difficulty" data-value="">todas</button>
          <button class="pill" data-filter="difficulty" data-value="Fácil">fácil</button>
          <button class="pill" data-filter="difficulty" data-value="Media">media</button>
          <button class="pill" data-filter="difficulty" data-value="Difícil">difícil</button>
        </div>
      </div>

      <div class="filter-row" id="row-time">
        <span class="flag">tiempo</span>
        <div class="pills" id="pills-time">
          <button class="pill active" data-filter="time" data-value="">cualquiera</button>
          <button class="pill" data-filter="time" data-value="30">≤ 30 min</button>
          <button class="pill" data-filter="time" data-value="60">≤ 1 hora</button>
          <button class="pill" data-filter="time" data-value="90">≤ 1.5 h</button>
        </div>
      </div>

      <div class="filter-row" id="row-category">
        <span class="flag">categoría</span>
        <div class="pills" id="pills-category">
          <button class="pill active" data-filter="category" data-value="">todas</button>
        </div>
      </div>

    </div>
  </div>

  <!-- Etiqueta activa: fuera del plegable, siempre visible -->
  <div class="filter-row tag-filter-row" id="tag-row" style="display:none">
    <span class="flag">etiqueta</span>
    <span class="tag-chip-active">
      <span class="tag-hash">#</span><span id="active-tag-text"></span>
      <button id="clear-active-tag" class="chip-x" aria-label="Quitar etiqueta">
        <svg width="9" height="9" viewBox="0 0 8 8" fill="none" aria-hidden="true">
          <path d="M1 1l6 6M7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </span>
  </div>

  <div class="divider"></div>

  <!-- Recuento -->
  <div class="status-bar">
    <svg class="status-star" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12 7.2-1.4 11.3-5.5 12-12z" fill="currentColor"/>
    </svg>
    <span id="results-count" class="results-text"></span>
    <button id="clear-filters" class="reset-btn" style="display:none">quitar filtros</button>
  </div>

</div>

<style>
  /* ── Contenedor ────────────────────────────────────────────
     Bloque centrado sobre la crema, no una caja: las piezas
     flotan como pegatinas sueltas. */
  .cmd-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Buscador ──────────────────────────────────────────── */
  .search-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 600px;
    background: var(--blanco);
    border: var(--borde);
    border-radius: var(--r-pildora);
    box-shadow: 4px 4px 0 var(--cielo-hondo);
    padding: 0.875rem 1.375rem;
  }

  .search-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    color: var(--tinta);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--cuerpo);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--tinta);
    caret-color: var(--rosa-ink);
  }

  .search-input::placeholder {
    color: var(--tinta-suave);
  }

  .clear-search {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    background: var(--rosa);
    border: 2px solid var(--tinta);
    border-radius: var(--r-pildora);
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .clear-search:hover {
    transform: scale(1.12);
  }

  /* ── Botón de filtros ──────────────────────────────────── */
  .filters-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--mantequilla);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    box-shadow: 3px 3px 0 var(--mantequilla-hondo);
    padding: 0.6875rem 1.25rem;
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .filters-toggle:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--mantequilla-hondo);
  }

  .filters-toggle[aria-expanded="true"] {
    background: var(--tinta);
    color: var(--crema);
  }

  .toggle-chevron {
    transition: transform 0.2s ease;
  }

  .filters-toggle[aria-expanded="true"] .toggle-chevron {
    transform: rotate(180deg);
  }

  /* ── Plegable ──────────────────────────────────────────── */
  .filters-collapse {
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    transition: grid-template-rows 0.25s ease;
  }

  .filters-collapse.open {
    grid-template-rows: 1fr;
  }

  .filters-collapse > .filter-rows {
    overflow: hidden;
  }

  .filter-rows {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0;
    transition: padding-top 0.25s ease;
  }

  .filters-collapse.open > .filter-rows {
    padding-top: 0.75rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .flag {
    font-family: var(--pixel);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--tinta-suave);
    flex-shrink: 0;
  }

  /* ── Píldoras ──────────────────────────────────────────────
     Cada grupo lleva su pastel. Las de categoría las crea el
     script sin más clase que .pill, por eso el color se aplica
     desde el contenedor y no desde la píldora. */
  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4375rem;
  }

  #pills-difficulty { --pastel: var(--rosa);  --hondo: var(--rosa-hondo); }
  #pills-time       { --pastel: var(--cielo); --hondo: var(--cielo-hondo); }
  #pills-category   { --pastel: var(--menta); --hondo: var(--menta-hondo); }

  .pill {
    background: var(--pastel);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    box-shadow: 3px 3px 0 var(--hondo);
    padding: 0.625rem 1.125rem;
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pill:hover:not(.active) {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--hondo);
  }

  .pill.active {
    background: var(--tinta);
    color: var(--crema);
  }

  /* ── Etiqueta activa ───────────────────────────────────── */
  .tag-filter-row {
    animation: row-in 0.18s ease;
  }

  @keyframes row-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .tag-chip-active {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    background: var(--lavanda);
    color: var(--lavanda-ink);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    box-shadow: 3px 3px 0 var(--lavanda-hondo);
    padding: 0.4375rem 0.4375rem 0.4375rem 0.875rem;
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .tag-hash {
    opacity: 0.5;
  }

  .chip-x {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    background: var(--blanco);
    border: 2px solid var(--tinta);
    border-radius: var(--r-pildora);
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .chip-x:hover {
    transform: scale(1.12);
  }

  /* ── Separador y recuento ──────────────────────────────── */
  .divider {
    width: 100%;
    max-width: 600px;
    height: 0;
    border-top: 3px dotted var(--lavanda-hondo);
    margin-top: 0.5rem;
  }

  .status-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-star {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--melocoton-hondo);
  }

  .results-text {
    font-family: var(--pixel);
    font-size: 0.6875rem;
    color: var(--tinta-suave);
  }

  .reset-btn {
    background: var(--blanco);
    border: 2px solid var(--tinta);
    border-radius: var(--r-pildora);
    box-shadow: 3px 3px 0 var(--rosa-hondo);
    padding: 0.4375rem 0.875rem;
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .reset-btn:hover {
    transform: translate(-1px, -1px);
  }

  /* ── Móvil ─────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .cmd-panel {
      margin-bottom: 2.25rem;
    }

    .search-line {
      padding: 0.8125rem 1.125rem;
    }

    .filter-row {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  // ── State ──────────────────────────────────────────────────────────────────
  let activeTag: string | null = null;
  let selectedCategory  = '';
  let selectedDifficulty = '';
  let selectedTime       = '';
  let pagefindSlugs: Set<string> | null = null;
  let pagefindInstance: any = null;
  let searchFallback = '';

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const searchInput      = document.getElementById('search-input')      as HTMLInputElement;
  const clearSearchBtn   = document.getElementById('clear-search')      as HTMLButtonElement;
  const clearFiltersBtn  = document.getElementById('clear-filters')     as HTMLButtonElement;
  const resultsCount     = document.getElementById('results-count')     as HTMLElement;
  const tagRow           = document.getElementById('tag-row')           as HTMLElement;
  const activeTagText    = document.getElementById('active-tag-text')   as HTMLElement;
  const clearTagBtn      = document.getElementById('clear-active-tag')  as HTMLButtonElement;
  const filtersToggle    = document.getElementById('filters-toggle')    as HTMLButtonElement;
  const filtersCollapse  = document.getElementById('filters-collapse')  as HTMLElement;
  const recipeCards      = document.querySelectorAll('.recipe-card')    as NodeListOf<HTMLElement>;

  // ── Collapse toggle ────────────────────────────────────────────────────────
  function setFiltersOpen(open: boolean) {
    filtersCollapse.classList.toggle('open', open);
    filtersToggle.setAttribute('aria-expanded', String(open));
  }

  filtersToggle.addEventListener('click', () => {
    setFiltersOpen(filtersToggle.getAttribute('aria-expanded') !== 'true');
  });

  // ── Populate category pills dynamically ───────────────────────────────────
  const categoryPills = document.getElementById('pills-category') as HTMLElement;
  const categories = new Set<string>();
  recipeCards.forEach(card => {
    const cat = card.querySelector('.category')?.textContent?.trim();
    if (cat) categories.add(cat);
  });
  categories.forEach(cat => {
    const btn = document.createElement('button');
    btn.className = 'pill';
    btn.dataset.filter = 'category';
    btn.dataset.value  = cat;
    btn.textContent    = cat.toLowerCase();
    categoryPills.appendChild(btn);
  });

  // ── Pagefind ───────────────────────────────────────────────────────────────
  async function getPagefind() {
    if (!pagefindInstance) {
      const pf = await import(`${import.meta.env.BASE_URL}/pagefind/pagefind.js`);
      await pf.init();
      pagefindInstance = pf;
    }
    return pagefindInstance;
  }

  async function searchWithPagefind(query: string) {
    const term = query.trim();
    if (!term) {
      pagefindSlugs = null;
      searchFallback = '';
      filterRecipes();
      return;
    }
    try {
      const pf = await getPagefind();
      const search = await pf.search(term);
      const slugs = new Set<string>();
      for (const result of search.results) {
        const data = await result.data();
        const match = data.url.match(/\/recipes\/([^/]+)\/?$/);
        if (match) slugs.add(match[1]);
      }
      pagefindSlugs = slugs;
      searchFallback = '';
    } catch {
      pagefindSlugs = null;
      searchFallback = term.toLowerCase();
    }
    filterRecipes();
  }

  // ── Core filter ────────────────────────────────────────────────────────────
  function filterRecipes() {
    const maxTime = selectedTime ? parseInt(selectedTime) : null;
    let visible = 0;

    recipeCards.forEach(card => {
      const slug       = (card as HTMLElement).dataset.slug ?? '';
      const title      = card.querySelector('h2')?.textContent?.toLowerCase() ?? '';
      const category   = card.querySelector('.category')?.textContent?.trim() ?? '';
      const difficulty = card.querySelector('.card-meta .meta-item:nth-child(2)')?.textContent?.trim() ?? '';
      // El tiempo ya no se lee del texto de la tarjeta: viene en segundos en un
      // data attribute. Se acabó el parser que intentaba entender «2 h 30 min».
      //
      // Y es `active_time`, no el total: quien filtra por «≤ 30 min» pregunta
      // cuánto tiene que currar, no cuánto tarda en fermentar. Con el total, el
      // kimchi y la masa de pizza no aparecerían nunca.
      const activeTime = Number((card as HTMLElement).dataset.activeTime ?? Infinity);
      const cardTags   = Array.from(card.querySelectorAll('.tag')).map(t => t.textContent?.trim() ?? '');

      const matchesSearch = pagefindSlugs
        ? pagefindSlugs.has(slug)
        : !searchFallback || title.includes(searchFallback) || cardTags.some(t => t.toLowerCase().includes(searchFallback));

      const ok =
        matchesSearch &&
        (!selectedCategory   || category === selectedCategory) &&
        (!selectedDifficulty || difficulty.includes(selectedDifficulty)) &&
        (!maxTime            || activeTime <= maxTime * 60) &&
        (!activeTag          || cardTags.includes(activeTag));

      const wrapper = (card as HTMLElement).parentElement;
      (wrapper ?? (card as HTMLElement)).style.display = ok ? '' : 'none';
      if (ok) visible++;
    });

    updateStatus(visible);
  }

  function updateStatus(count: number) {
    const total = recipeCards.length;
    resultsCount.textContent = count === total
      ? `${count} recetas`
      : `${count} de ${total} recetas`;

    const anyFilter = selectedCategory || selectedDifficulty || selectedTime
                    || activeTag || searchInput.value.trim();
    clearFiltersBtn.style.display  = anyFilter ? 'inline-block' : 'none';
    clearSearchBtn.style.display   = searchInput.value.trim() ? 'flex' : 'none';
  }

  // ── Pills ──────────────────────────────────────────────────────────────────
  document.querySelectorAll('.pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const btn  = pill as HTMLButtonElement;
      const type = btn.dataset.filter!;
      const val  = btn.dataset.value!;

      if (type === 'category')   selectedCategory   = val;
      if (type === 'difficulty') selectedDifficulty = val;
      if (type === 'time')       selectedTime       = val;

      document.querySelectorAll(`.pill[data-filter="${type}"]`)
        .forEach(p => p.classList.remove('active'));
      btn.classList.add('active');

      filterRecipes();
    });
  });

  // ── Tag display ────────────────────────────────────────────────────────────
  function setTagDisplay() {
    recipeCards.forEach(card => {
      card.querySelectorAll('.tag-clickable').forEach(el => {
        (el as HTMLElement).classList.toggle('active', (el as HTMLElement).dataset.tag === activeTag);
      });
    });
    if (activeTag) {
      activeTagText.textContent = activeTag;
      tagRow.style.display = 'flex';
    } else {
      tagRow.style.display = 'none';
    }
  }

  function setActiveTag(tag: string | null) {
    activeTag = activeTag === tag ? null : tag;
    setTagDisplay();
    filterRecipes();
  }

  clearTagBtn.addEventListener('click', () => {
    activeTag = null;
    setTagDisplay();
    filterRecipes();
  });

  // ── Search ─────────────────────────────────────────────────────────────────
  searchInput.addEventListener('input', () => searchWithPagefind(searchInput.value));

  clearSearchBtn.addEventListener('click', () => {
    searchInput.value = '';
    pagefindSlugs = null;
    searchFallback = '';
    filterRecipes();
  });

  // ── Reset all ──────────────────────────────────────────────────────────────
  clearFiltersBtn.addEventListener('click', () => {
    searchInput.value  = '';
    pagefindSlugs      = null;
    searchFallback     = '';
    selectedCategory   = '';
    selectedDifficulty = '';
    selectedTime       = '';
    activeTag          = null;

    document.querySelectorAll('.pill').forEach(p => {
      (p as HTMLButtonElement).classList.toggle('active',
        (p as HTMLButtonElement).dataset.value === '');
    });

    setTagDisplay();
    filterRecipes();
  });

  // ── Tag events from cards ──────────────────────────────────────────────────
  window.addEventListener('selectTag', ((e: CustomEvent) => {
    setActiveTag(e.detail?.tag ?? null);
  }) as EventListener);

  // ── URL param ?tag= ────────────────────────────────────────────────────────
  const tagFromUrl = new URLSearchParams(window.location.search).get('tag');
  if (tagFromUrl) {
    activeTag = tagFromUrl;
    setTagDisplay();
    window.history.replaceState({}, '', window.location.pathname);
  }

  // ── Initial render ─────────────────────────────────────────────────────────
  filterRecipes();
</script>

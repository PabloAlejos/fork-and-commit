---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	slug: string;
	category: string;
	totalTime: string;
	difficulty: string;
	servings: number;
	tags?: string[];
	image?: ImageMetadata;
	index?: number;
}

const {
	title,
	slug,
	category,
	totalTime,
	difficulty,
	servings,
	tags = [],
	image,
	index = 0
} = Astro.props;

// El pastel, la trama y el giro salen del índice: deterministas,
// así una receta se pinta siempre igual entre recargas.
const PASTELES = ['lavanda', 'menta', 'melocoton', 'cielo', 'rosa', 'mantequilla'] as const;
const TRAMAS   = ['puntos', 'ondas', 'cuadricula', 'rayas'] as const;
const GIROS    = ['-1.1deg', '0.9deg', '-0.6deg', '1.2deg', '-0.9deg', '0.7deg', '-1deg', '0.8deg'];

const pastel = PASTELES[index % PASTELES.length];
const trama  = TRAMAS[index % TRAMAS.length];
const giro   = GIROS[index % GIROS.length];
const numero = String(index + 1).padStart(2, '0');
const inicial = title.trim().charAt(0).toUpperCase();

const href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}recipes/${slug}`;
---

<a
	href={href}
	class="recipe-card"
	data-slug={slug}
	style={`--pastel: var(--${pastel}); --hondo: var(--${pastel}-hondo); --ink: var(--${pastel}-ink); --giro: ${giro};`}
>
	<article>
		<div class="card-visual">
			{image ? (
				<Image
					src={image}
					alt={title}
					class="card-foto"
					widths={[300, 600]}
					sizes="(max-width: 640px) 90vw, 380px"
				/>
			) : (
				<div class={`card-inicial trama-${trama}`} aria-hidden="true">{inicial}</div>
			)}
			<span class="card-num">{numero}</span>
		</div>

		<div class="card-body">
			<span class="category">{category}</span>

			<h2>{title}</h2>

			<div class="card-meta">
				<span class="meta-item">
					<svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="10" cy="10" r="7.5" />
						<path d="M10 5.5V10l3.2 2" />
					</svg>
					{totalTime}
				</span>
				<span class="meta-item">
					<svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
						<path d="M10 2.2c-.5 2-2.5 3.5-2.5 6a2.5 2.5 0 005 0c0-2.5-2-4-2.5-6z" />
						<path d="M7 14c0 1.7 1.3 3 3 3s3-1.3 3-3" />
					</svg>
					{difficulty}
				</span>
				<span class="meta-item">
					<svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="10" cy="8" r="3" />
						<path d="M4.5 16.5c.6-2.8 2.8-4.3 5.5-4.3s4.9 1.5 5.5 4.3" />
					</svg>
					{servings}
				</span>
			</div>

			{tags && tags.length > 0 && (
				<div class="tags">
					{tags.slice(0, 3).map(tag => (
						<button type="button" class="tag tag-clickable" data-tag={tag}>{tag}</button>
					))}
					{tags.length > 3 && (
						<span class="tag-more">+{tags.length - 3}</span>
					)}
				</div>
			)}
		</div>
	</article>
</a>

<style>
	/* ── Tarjeta ───────────────────────────────────────────────
	   Borde grueso, radio grande y sombra dura desplazada: el
	   gesto de pegatina. El giro es leve a propósito —lo justo
	   para que se lea como puesto a mano y no como un error. */
	.recipe-card {
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--blanco);
		border: var(--borde);
		border-radius: var(--r-tarjeta);
		box-shadow: 7px 7px 0 var(--hondo);
		transform: rotate(var(--giro));
		transition: transform 0.18s ease, box-shadow 0.18s ease;
	}

	.recipe-card:hover {
		transform: rotate(var(--giro)) translate(-3px, -3px);
		box-shadow: 11px 11px 0 var(--hondo);
	}

	.recipe-card article {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem;
	}

	/* ── Visual ────────────────────────────────────────────── */
	.card-visual {
		position: relative;
	}

	.card-foto {
		width: 100%;
		height: 152px;
		object-fit: cover;
		border: var(--borde-fino);
		border-radius: 20px;
	}

	/* Sin foto: bloque pastel con trama y la inicial en grande.
	   No es un hueco esperando imagen, es una pieza terminada. */
	.card-inicial {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 152px;
		background-color: var(--pastel);
		background-size: 15px 15px;
		border: var(--borde-fino);
		border-radius: 20px;
		font-family: var(--display);
		font-weight: 800;
		font-size: 4.75rem;
		line-height: 1;
		color: var(--hondo);
		user-select: none;
	}

	.trama-puntos { background-image: var(--trama-puntos); }
	.trama-cuadricula { background-image: var(--trama-cuadricula); background-size: 22px 22px; }
	.trama-rayas  { background-image: var(--trama-rayas); }
	.trama-ondas  { background-image: var(--trama-ondas); }

	.card-num {
		position: absolute;
		top: -12px;
		left: -12px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: var(--blanco);
		border: var(--borde-fino);
		border-radius: var(--r-pildora);
		font-family: var(--pixel);
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--tinta);
	}

	/* ── Cuerpo ────────────────────────────────────────────── */
	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0 0.375rem 0.5rem;
	}

	.category {
		align-self: flex-start;
		background: var(--pastel);
		color: var(--ink);
		border: 2px solid var(--tinta);
		border-radius: var(--r-pildora);
		padding: 5px 11px;
		font-family: var(--pixel);
		font-size: 0.625rem;
		line-height: 1.5;
		letter-spacing: 0.04em;
		text-transform: lowercase;
	}

	.card-body h2 {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.5rem;
		line-height: 1.12;
		letter-spacing: -0.02em;
		color: var(--tinta);
		text-wrap: pretty;
	}

	/* ── Datos ─────────────────────────────────────────────── */
	.card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
		padding: 0.6875rem 0;
		border-top: 2.5px dotted var(--hondo);
		border-bottom: 2.5px dotted var(--hondo);
	}

	.meta-item {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-weight: 700;
		font-size: 0.8125rem;
		color: var(--tinta);
	}

	.icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	/* ── Etiquetas ─────────────────────────────────────────── */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	/* ── Móvil ─────────────────────────────────────────────── */
	@media (max-width: 640px) {
		.card-foto,
		.card-inicial {
			height: 140px;
		}

		.card-inicial {
			font-size: 4.125rem;
		}

		.card-body h2 {
			font-size: 1.4375rem;
		}
	}
</style>

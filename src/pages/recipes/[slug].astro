---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import {
  contenidoAHtml,
  formatearDuracion,
  pasosDeTipo,
  textoIngrediente,
} from '../../lib/receta.ts';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');

  return recipes.map(recipe => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;

// La receta se pinta desde el frontmatter, no desde el cuerpo del .md. El
// cuerpo se sigue generando al publicar, pero solo para que el fichero se lea
// bien en GitHub: aquí la única fuente es la estructura, que es la misma que
// consume el modo cocina. Así las dos vistas no pueden decir cosas distintas.
const receta = recipe.data;

const inicio = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rutaCocina = `${inicio}recipes/${recipe.slug}/cook`;

const fecha = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(receta.date);

// Sigue siendo un campo propio y no se deriva de `ingredients`. Derivarla la
// convierte en la lista de ingredientes otra vez, que es justo lo que no es:
// aquí van las cosas que hay que comprar, sin la sal, el aceite ni las
// especias que ya están en el armario. Eso es criterio, no un filtro.
const compra = receta.shopping_list;

const datos = [
  { etiqueta: 'Dificultad',    valor: receta.difficulty,                        pastel: 'rosa' },
  { etiqueta: 'Tiempo total',  valor: formatearDuracion(receta.total_time),     pastel: 'cielo' },
  { etiqueta: 'Tiempo activo', valor: formatearDuracion(receta.active_time),    pastel: 'mantequilla' },
  { etiqueta: 'Raciones',      valor: `${receta.servings} ${receta.servings === 1 ? 'persona' : 'personas'}`, pastel: 'menta' },
];

// Los reposos y la mise en place van juntos bajo «Preparación previa», y los
// utensilios dentro, como estaban en el markdown. No es capricho: el color de
// cada `h2` sale de su posición (`nth-of-type(3n+2)`), así que sacar los
// utensilios o los reposos a sección propia repinta media receta.
const previos = [...pasosDeTipo(receta.steps, 'rest'), ...pasosDeTipo(receta.steps, 'prep')];
const elaboracion = pasosDeTipo(receta.steps, 'cook');
const emplatado = pasosDeTipo(receta.steps, 'plate');

const anio = new Date().getFullYear();
---

<Layout title={recipe.data.title}>
  <div class="pagina">
    <div class="mancha mancha-a" aria-hidden="true"></div>
    <div class="mancha mancha-b" aria-hidden="true"></div>

    <!-- Barra -->
    <header class="barra" data-pagefind-ignore>
      <div class="barra-izq">
        <a href={inicio} class="volver">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 10H5"/><path d="M9.5 5.5L5 10l4.5 4.5"/>
          </svg>
          volver
        </a>
        <span class="logo">
          <svg class="estrella" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12 7.2-1.4 11.3-5.5 12-12z" fill="currentColor"/>
          </svg>
          Fork &amp; Commit
        </span>
      </div>

      <button type="button" id="imprimir" class="accion" aria-label="Imprimir la receta">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 8V3.8h8V8"/><rect x="3.6" y="8" width="12.8" height="6" rx="1.6"/><path d="M6 12h8v4.2H6z"/>
        </svg>
      </button>
    </header>

    <div data-pagefind-body>
      <!-- Cabecera de la receta -->
      <section class="cabecera">
        <div class={`panel ${recipe.data.image ? 'panel-con-foto' : ''}`}>
          <div class="panel-texto">
            <span class="chip-cat">{recipe.data.category} · {fecha}</span>

            <h1>{recipe.data.title}</h1>

            <svg class="onda" viewBox="0 0 120 14" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" preserveAspectRatio="none" aria-hidden="true">
              <path d="M3 7q7.5-6 15 0t15 0t15 0t15 0t15 0t15 0t15 0"/>
            </svg>

            {recipe.data.tags && recipe.data.tags.length > 0 && (
              <div class="tags">
                {recipe.data.tags.map(tag => (
                  <a href={`${inicio}?tag=${encodeURIComponent(tag)}`} class="tag tag-link">{tag}</a>
                ))}
              </div>
            )}
          </div>

          {recipe.data.image && (
            <div class="panel-foto">
              <svg class="estrella-deco" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12 7.2-1.4 11.3-5.5 12-12z" fill="currentColor"/>
              </svg>
              <Image
                src={recipe.data.image}
                alt={recipe.data.title}
                class="foto"
                widths={[400, 800, 1200]}
                sizes="(max-width: 60rem) 92vw, 620px"
              />
            </div>
          )}
        </div>
      </section>

      <!-- Datos -->
      <section class="datos">
        {datos.map(d => (
          <div class="dato" style={`--pastel: var(--${d.pastel}); --hondo: var(--${d.pastel}-hondo); --ink: var(--${d.pastel}-ink);`}>
            <span class="dato-etiqueta">{d.etiqueta}</span>
            <span class="dato-valor">{d.valor}</span>
          </div>
        ))}
      </section>

      <!-- Entrada al modo cocina. Fuera del índice de Pagefind y de la
           impresión: es una acción, no contenido de la receta. -->
      <div class="cocinar-zona" data-pagefind-ignore>
        <a href={`${rutaCocina}`} class="btn-cocinar">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3.5 8.5h13"/><path d="M4.5 8.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/>
            <path d="M2.5 11.5h15l-1.5 4.5h-12z"/>
          </svg>
          Cocinar paso a paso
        </a>
        <p class="cocinar-nota">pantalla encendida, temporizadores y una mano libre</p>
      </div>

      <!-- Cuerpo -->
      <div class={`cuerpo ${compra.length > 0 ? '' : 'cuerpo-solo'}`}>
        {compra.length > 0 && (
          <aside class="rail" data-pagefind-ignore>
            <div class="compra">
              <div class="compra-titulo">
                <svg class="estrella" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12 7.2-1.4 11.3-5.5 12-12z" fill="currentColor"/>
                </svg>
                Lista de la compra
              </div>
              <ul class="compra-lista">
                {compra.map(item => (
                  <li>
                    <label>
                      <input type="checkbox" />
                      <span class="casilla" aria-hidden="true">
                        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2.4 6.3l2.3 2.3L9.6 3.4"/>
                        </svg>
                      </span>
                      <span class="texto">{item}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}

        <article class="recipe-content">
          {/* El h1 va oculto por CSS y repite el título, pero no sobra: es lo
              que hace que el párrafo siguiente sea la entradilla destacada
              (`.recipe-content h1 + p`). Sin él, la entradilla se pinta como
              un párrafo cualquiera. */}
          <h1>{receta.title}</h1>
          <p>{receta.description}</p>

          <h2>Ingredientes ({receta.servings} {receta.servings === 1 ? 'persona' : 'personas'})</h2>

          {receta.ingredients.map(grupo => (
            <>
              {grupo.group && <h3>{grupo.group}</h3>}
              <ul>
                {grupo.items.map(item => <li>{textoIngrediente(item)}</li>)}
              </ul>
            </>
          ))}

          {(receta.utensils.length > 0 || previos.length > 0) && (
            <>
              <h2>Preparación previa</h2>

              {receta.utensils.length > 0 && (
                <>
                  <h3>Utensilios necesarios</h3>
                  <ul>
                    {receta.utensils.map(utensilio => <li>{utensilio}</li>)}
                  </ul>
                </>
              )}

              {previos.map(paso => (
                <>
                  <h3>{paso.timer ? `${paso.title} (${formatearDuracion(paso.timer)})` : paso.title}</h3>
                  <Fragment set:html={contenidoAHtml(paso.content)} />
                </>
              ))}
            </>
          )}

          {elaboracion.length > 0 && (
            <>
              <h2>Elaboración</h2>
              {elaboracion.map(paso => (
                <>
                  <h3>{paso.timer ? `${paso.title} (${formatearDuracion(paso.timer)})` : paso.title}</h3>
                  <Fragment set:html={contenidoAHtml(paso.content)} />
                </>
              ))}
            </>
          )}

          {emplatado.length > 0 && (
            <>
              <h2>Emplatado</h2>
              {emplatado.map(paso => (
                <>
                  {/* Con un solo paso de emplatado el título sobra: el h2 ya lo
                      dice. Era así en el markdown y se lee mejor. */}
                  {emplatado.length > 1 && <h3>{paso.title}</h3>}
                  <Fragment set:html={contenidoAHtml(paso.content)} />
                </>
              ))}
            </>
          )}

          {receta.notes.length > 0 && (
            <>
              <h2>Notas</h2>
              <ul>
                {receta.notes.map(nota => (
                  <li><strong>{nota.title}</strong>: {nota.content}</li>
                ))}
              </ul>
            </>
          )}
        </article>
      </div>
    </div>

    <div class="cierre" data-pagefind-ignore>
      <a href={inicio} class="volver-grande">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 10H5"/><path d="M9.5 5.5L5 10l4.5 4.5"/>
        </svg>
        volver al recetario
      </a>
    </div>

    <div class="damero" aria-hidden="true"></div>

    <footer class="site-footer" data-pagefind-ignore>
      <span class="logo logo-pie">
        <svg class="estrella" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c.7 6.5 4.8 10.6 12 12-7.2 1.4-11.3 5.5-12 12-.7-6.5-4.8-10.6-12-12 7.2-1.4 11.3-5.5 12-12z" fill="currentColor"/>
        </svg>
        Fork &amp; Commit
      </span>
      <div class="pie-derecha">
        <span class="footer-nota">hecho en la cocina · {anio}</span>
        <a href={`${inicio}admin`} class="admin-link" rel="nofollow">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16H4v-3z"/><path d="M11.5 5.5l3 3"/></svg>
          admin
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .pagina {
    position: relative;
    overflow-x: clip;
  }

  /* ── Manchas ───────────────────────────────────────────── */
  .mancha {
    position: absolute;
    z-index: 0;
    opacity: 0.5;
    pointer-events: none;
  }

  .mancha-a {
    top: 38rem;
    right: -9rem;
    width: 22rem;
    height: 20rem;
    background: var(--menta);
    border-radius: 58% 42% 50% 50% / 52% 46% 54% 48%;
  }

  .mancha-b {
    top: 100rem;
    left: -8rem;
    width: 20rem;
    height: 19rem;
    background: var(--melocoton);
    border-radius: 45% 55% 62% 38% / 48% 58% 42% 52%;
  }

  /* ── Barra ─────────────────────────────────────────────── */
  .barra {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.625rem 4rem;
  }

  .barra-izq {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--blanco);
    border: var(--borde);
    border-radius: var(--r-pildora);
    box-shadow: 4px 4px 0 var(--menta-hondo);
    padding: 0.75rem 1.375rem;
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--tinta);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .volver:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--menta-hondo);
    color: var(--tinta);
  }

  .volver svg { width: 18px; height: 18px; }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--mantequilla);
    border: var(--borde);
    border-radius: var(--r-pildora);
    box-shadow: 4px 4px 0 var(--mantequilla-hondo);
    padding: 0.6875rem 1.375rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
    transform: rotate(-1.4deg);
  }

  .estrella { width: 16px; height: 16px; flex-shrink: 0; }

  .accion {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    background: var(--cielo);
    border: var(--borde);
    border-radius: var(--r-pildora);
    box-shadow: 4px 4px 0 var(--cielo-hondo);
    color: var(--tinta);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .accion:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--cielo-hondo);
  }

  .accion svg { width: 20px; height: 20px; }

  /* ── Panel de cabecera ─────────────────────────────────── */
  .cabecera {
    position: relative;
    z-index: 1;
    max-width: 87.5rem;
    margin: 0 auto;
    padding: 2rem 4rem 0;
  }

  .panel {
    background: var(--lavanda);
    border: var(--borde);
    border-radius: 2.5rem;
    box-shadow: 9px 9px 0 var(--lavanda-hondo);
    padding: 3rem 3.25rem;
  }

  .panel-con-foto {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .chip-cat {
    display: inline-block;
    background: var(--menta);
    color: var(--menta-ink);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    padding: 0.4375rem 1rem;
    font-family: var(--pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    margin-bottom: 1.375rem;
  }

  .panel h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.875rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--tinta);
    text-wrap: pretty;
  }

  .onda {
    width: 12.5rem;
    max-width: 60%;
    height: 1rem;
    color: var(--melocoton-hondo);
    margin: 1rem 0 1.25rem;
  }

  .panel .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    --pastel: var(--blanco);
    --hondo: var(--lavanda-hondo);
    --ink: var(--tinta);
  }

  .panel-foto {
    position: relative;
  }

  .estrella-deco {
    position: absolute;
    top: -1.625rem;
    right: -1.25rem;
    z-index: 1;
    width: 38px;
    height: 38px;
    color: var(--melocoton-hondo);
  }

  .foto {
    width: 100%;
    height: 21.25rem;
    object-fit: cover;
    border: var(--borde);
    border-radius: 1.75rem;
    box-shadow: 8px 8px 0 var(--blanco);
    transform: rotate(1.6deg);
  }

  /* ── Datos ─────────────────────────────────────────────── */
  .datos {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem;
    max-width: 87.5rem;
    margin: 0 auto;
    padding: 2.5rem 4rem 0;
  }

  .cocinar-zona {
    position: relative;
    z-index: 1;
    max-width: 87.5rem;
    margin: 0 auto;
    padding: 2rem 4rem 0;
    text-align: center;
  }

  .btn-cocinar {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 60px;
    padding: 0 2rem;
    font-family: var(--display);
    font-size: 1.1875rem;
    font-weight: 800;
    color: var(--tinta);
    background: var(--menta);
    border: var(--borde);
    border-radius: var(--r-pildora);
    box-shadow: 6px 6px 0 var(--menta-hondo);
    text-decoration: none;
  }

  .btn-cocinar svg { width: 24px; height: 24px; }

  .btn-cocinar:active { transform: translate(3px, 3px); box-shadow: 3px 3px 0 var(--menta-hondo); }

  .cocinar-nota {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--tinta-suave);
  }

  .dato {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    background: var(--pastel);
    border: var(--borde);
    border-radius: 1.25rem;
    box-shadow: 5px 5px 0 var(--hondo);
    padding: 1rem 1.375rem;
  }

  .dato-etiqueta {
    font-family: var(--pixel);
    font-size: 0.5938rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .dato-valor {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }

  /* ── Cuerpo ────────────────────────────────────────────── */
  .cuerpo {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 20.625rem minmax(0, 1fr);
    gap: 3.5rem;
    max-width: 87.5rem;
    margin: 0 auto;
    padding: 3.5rem 4rem 0;
    align-items: start;
  }

  .cuerpo-solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .rail {
    position: sticky;
    top: 1.5rem;
  }

  .compra {
    background: var(--menta);
    border: var(--borde);
    border-radius: var(--r-tarjeta);
    box-shadow: 6px 6px 0 var(--menta-hondo);
    padding: 1.5rem;
  }

  .compra-titulo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
    margin-bottom: 1rem;
  }

  .compra-lista {
    display: flex;
    flex-direction: column;
    gap: 0.5625rem;
    list-style: none;
  }

  .compra-lista label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--blanco);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    padding: 0.625rem 1rem;
    cursor: pointer;
  }

  .compra-lista input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .casilla {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    background: var(--blanco);
    border: var(--borde-fino);
    border-radius: var(--r-pildora);
    color: transparent;
  }

  .casilla svg { width: 11px; height: 11px; }

  .compra-lista .texto {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--tinta);
  }

  .compra-lista input:checked ~ .casilla {
    background: var(--tinta);
    color: var(--menta);
  }

  .compra-lista input:checked ~ .texto {
    font-weight: 400;
    color: var(--tinta-suave);
    text-decoration: line-through;
  }

  .compra-lista input:focus-visible ~ .casilla {
    outline: 3px solid var(--tinta);
    outline-offset: 3px;
  }

  /* ── Markdown ──────────────────────────────────────────────
     El cuerpo va sobre panel blanco: el texto largo directamente
     sobre la trama de puntos se lee peor.
     El h1 del markdown repite el title del frontmatter, así que
     se oculta y el primer párrafo pasa a hacer de entradilla. */
  .recipe-content {
    background: var(--blanco);
    border: var(--borde);
    border-radius: var(--r-panel);
    box-shadow: 7px 7px 0 var(--rosa-hondo);
    padding: 2.5rem 3rem;
  }

  .recipe-content :global(h1) {
    display: none;
  }

  .recipe-content :global(h1 + p) {
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--cielo-ink);
    background: var(--cielo);
    border: var(--borde);
    border-radius: var(--r-tarjeta);
    box-shadow: 6px 6px 0 var(--cielo-hondo);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.5rem;
    text-wrap: pretty;
  }

  .recipe-content :global(h2) {
    display: inline-block;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.03em;
    color: var(--tinta);
    background: var(--melocoton);

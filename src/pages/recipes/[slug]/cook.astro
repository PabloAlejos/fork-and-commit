---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

import {
  LIMITE_TEMPORIZADOR,
  contenidoAHtml,
  formatearDuracion,
  indexarIngredientes,
  ingredientesDelPaso,
  pasosDeTipo,
  textoIngrediente,
} from '../../../lib/receta.ts';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');

  return recipes.map(recipe => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const receta = recipe.data;

const inicio = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rutaReceta = `${inicio}recipes/${recipe.slug}`;

const indice = indexarIngredientes(receta.ingredients);

// La mise en place se saca del hilo y va toda junta en una pantalla: cuando
// estás cortando quieres ver todo lo que hay que cortar, no ir de uno en uno.
// El resto conserva el orden del fichero, que es el orden de ejecución.
const preparacion = pasosDeTipo(receta.steps, 'prep');
const ejecucion = receta.steps.filter(paso => paso.type !== 'prep');

// Los reposos se avisan arriba del todo en el resumen. Es la información que
// decide si puedes ponerte a cocinar ahora o tenías que haber empezado ayer.
const reposos = pasosDeTipo(receta.steps, 'rest').filter(paso => paso.timer);

// Las pantallas se numeran aquí, en build, y el cliente solo enseña y esconde.
// Sin plantillas en el navegador: todo el texto va en el HTML desde el
// principio, que es lo que hace que esto funcione sin conexión.
let n = 0;
const pantallaResumen = n++;
const pantallaPrep = preparacion.length > 0 ? n++ : null;
const pantallasEjecucion = ejecucion.map(() => n++);
const pantallaFinal = n++;
const totalPantallas = n;
---

<Layout title={`Cocinando · ${receta.title}`}>
  {/* Antes de pintar nada: si esperamos al script del final, el modo oscuro
      entra con un fogonazo crema. Va inline y va aquí a propósito. */}
  <script is:inline>
    document.documentElement.dataset.cocina =
      localStorage.getItem('cocina:tema') === 'claro' ? 'claro' : 'oscuro';
  </script>

  <div class="cocina" data-cocina data-total={totalPantallas}>
    <header class="barra-sup">
      <a href={rutaReceta} class="salir" data-salir>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l8 8M14 6l-8 8"/>
        </svg>
        salir
      </a>
      <div class="barra-der">
        <button type="button" class="tema" data-tema aria-label="Cambiar entre claro y oscuro">
          <svg class="ico-luna" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9z"/>
          </svg>
          <svg class="ico-sol" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="10" cy="10" r="3.6"/>
            <path d="M10 2v1.6M10 16.4V18M18 10h-1.6M3.6 10H2M15.7 4.3l-1.1 1.1M5.4 14.6l-1.1 1.1M15.7 15.7l-1.1-1.1M5.4 5.4L4.3 4.3"/>
          </svg>
        </button>
      </div>
    </header>

    {/* Cuántos pasos quedan, de un vistazo y sin leer. Un segmento por
        pantalla de cocinado — ni el resumen ni el final cuentan. */}
    <div class="progreso" aria-hidden="true">
      {Array.from({ length: totalPantallas - 2 }).map((_, i) => (
        <span class="segmento" data-segmento={i + 1}></span>
      ))}
    </div>

    <main class="lienzo">
      {/* ── Resumen ─────────────────────────────────────────── */}
      <section class="pantalla" data-pantalla={pantallaResumen}>
        <p class="sobretitulo">Vas a cocinar</p>
        <h1 class="titulo-receta">{receta.title}</h1>

        {reposos.length > 0 && (
          <div class="aviso">
            <p class="aviso-titulo">Esto no se hace del tirón</p>
            <ul>
              {reposos.map(paso => (
                <li><strong>{paso.title}</strong> — {formatearDuracion(paso.timer!)}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="bloque">
          <h2>Ingredientes</h2>
          {receta.ingredients.map(grupo => (
            <>
              {grupo.group && <h3>{grupo.group}</h3>}
              <ul class="lista-ing">
                {grupo.items.map(item => <li>{textoIngrediente(item)}</li>)}
              </ul>
            </>
          ))}
        </div>

        {receta.utensils.length > 0 && (
          <div class="bloque bloque-utensilios">
            <h2>Utensilios</h2>
            <ul class="lista-ing">
              {receta.utensils.map(u => <li>{u}</li>)}
            </ul>
          </div>
        )}
      </section>

      {/* ── Mise en place ───────────────────────────────────── */}
      {pantallaPrep !== null && (
        <section class="pantalla" data-pantalla={pantallaPrep} hidden>
          <p class="sobretitulo">Antes de encender el fuego</p>
          <h2 class="titulo-pantalla">Preparación</h2>

          <ul class="checklist">
            {preparacion.map(paso => (
              <li>
                <label>
                  <input type="checkbox" data-hecho={paso.id} />
                  <span class="casilla" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2.4 6.3l2.3 2.3L9.6 3.4"/>
                    </svg>
                  </span>
                  <span class="checklist-texto">
                    <span class="checklist-titulo">{paso.title}</span>
                    <Fragment set:html={contenidoAHtml(paso.content)} />
                    {ingredientesDelPaso(paso, indice).length > 0 && (
                      <span class="ing-paso">
                        {ingredientesDelPaso(paso, indice).map(item => (
                          <span class="chip-ing">{textoIngrediente(item)}</span>
                        ))}
                      </span>
                    )}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* ── Ejecución ───────────────────────────────────────── */}
      {ejecucion.map((paso, i) => {
        const ingredientes = ingredientesDelPaso(paso, indice);
        const largo = paso.timer !== undefined && paso.timer > LIMITE_TEMPORIZADOR;

        return (
          <section class="pantalla" data-pantalla={pantallasEjecucion[i]} hidden>
            <p class="sobretitulo">Paso {i + 1} de {ejecucion.length}</p>
            <h2 class="titulo-pantalla">{paso.title}</h2>

            {ingredientes.length > 0 && (
              <div class="ing-paso ing-paso-bloque">
                {ingredientes.map(item => (
                  <span class="chip-ing">{textoIngrediente(item)}</span>
                ))}
              </div>
            )}

            <div class="texto-paso">
              <Fragment set:html={contenidoAHtml(paso.content)} />
            </div>

            {paso.timer !== undefined && !largo && (
              <div class="zona-timer">
                {/* El número grande es el protagonista, y al arrancar pasa a
                    ser la cuenta atrás en vivo. */}
                <p class="duracion" data-duracion-de={paso.id}>{formatearDuracion(paso.timer)}</p>
                <button
                  type="button"
                  class="btn-play"
                  data-arrancar={paso.id}
                  data-segundos={paso.timer}
                  data-etiqueta={paso.title}
                  aria-label={`Poner temporizador de ${formatearDuracion(paso.timer)}`}
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M9 6.5l9 5.5-9 5.5z"/>
                  </svg>
                </button>
              </div>
            )}

            {largo && (
              <div class="reposo-largo">
                {/* Un setInterval de horas no sobrevive a que bloquees el móvil.
                    Mejor decir la verdad y ofrecer el temporizador del sistema,
                    que sí suena con la app cerrada. */}
                <p><strong>{formatearDuracion(paso.timer!)}</strong> — demasiado para un temporizador del navegador.</p>
                <a
                  class="btn-atajo"
                  href={`shortcuts://x-callback-url/run-shortcut?name=Temporizador&input=${paso.timer}`}
                >
                  Usar el temporizador del móvil
                </a>
              </div>
            )}
          </section>
        );
      })}

      {/* ── Final ───────────────────────────────────────────── */}
      <section class="pantalla pantalla-final" data-pantalla={pantallaFinal} hidden>
        <p class="sobretitulo">Listo</p>
        <h2 class="titulo-pantalla">A comer</h2>
        <p class="cierre-texto">Si sobra, ya sabes dónde están las notas de conservación.</p>

        {/* Al terminar puede quedar algo al fuego. Se avisa y se ofrece
            pararlos, pero no se cancelan solos: igual el caldo sigue. */}
        <div class="pendientes" data-pendientes hidden>
          <p data-pendientes-texto></p>
          <button type="button" class="btn-atajo" data-parar-todo>parar los temporizadores</button>
        </div>

        <a href={rutaReceta} class="btn-volver">volver a la receta</a>
      </section>
    </main>

    {/* Barra de temporizadores: fija, visible en todas las pantallas, y con
        varios a la vez. Es el requisito que rompe el diseño ingenuo. */}
    <div class="timers" data-timers hidden aria-live="polite"></div>

    <nav class="navegacion" data-nav>
      <button type="button" class="nav-circ" data-anterior aria-label="Paso anterior">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4.5L6.5 10l5.5 5.5"/>
        </svg>
      </button>
      <span class="nav-cuenta" data-posicion aria-live="polite"></span>

      <button type="button" class="nav-circ nav-avanza" data-siguiente>
        <span class="nav-empezar" data-etiqueta-siguiente>Empezar</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 4.5L13.5 10 8 15.5"/>
        </svg>
      </button>
    </nav>
  </div>
</Layout>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-cocina]');
  if (raiz) {
    const total = Number(raiz.dataset.total);
    const pantallas = Array.from(raiz.querySelectorAll<HTMLElement>('[data-pantalla]'));
    const barra = raiz.querySelector<HTMLElement>('[data-timers]')!;
    const posicion = raiz.querySelector<HTMLElement>('[data-posicion]')!;
    const btnAnterior = raiz.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const btnSiguiente = raiz.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const nav = raiz.querySelector<HTMLElement>('[data-nav]');
    const segmentos = Array.from(raiz.querySelectorAll<HTMLElement>('[data-segmento]'));

    const CLAVE = `cocina:${location.pathname}`;

    interface Timer {
      pasoId: string;
      etiqueta: string;
      /** Timestamp absoluto. Nunca un contador que se decrementa: si iOS
          suspende la pestaña, un contador pierde tiempo y una fecha no. */
      finEn: number;
      duracion: number;
      pantalla: number;
      avisado: boolean;
    }

    let indice = 0;
    const timers = new Map<string, Timer>();

    // ── Persistencia ────────────────────────────────────────────────────────
    // Solo dentro de la pestaña. Cubre el caso real de salir a mirar la receta
    // y volver: sin esto, los timers en marcha se pierden.
    function guardar() {
      try {
        sessionStorage.setItem(CLAVE, JSON.stringify({
          indice,
          timers: [...timers.values()],
          hechos: [...raiz!.querySelectorAll<HTMLInputElement>('[data-hecho]')]
            .filter(c => c.checked)
            .map(c => c.dataset.hecho),
        }));
      } catch {
        // Modo privado, cuota llena: que no se caiga el modo cocina por esto.
      }
    }

    function restaurar() {
      let guardado: any;
      try {
        guardado = JSON.parse(sessionStorage.getItem(CLAVE) ?? 'null');
      } catch {
        return;
      }
      if (!guardado) return;

      for (const t of guardado.timers ?? []) {
        // Los que vencieron mientras no estabas se recuperan ya terminados.
        timers.set(t.pasoId, t);
      }
      for (const id of guardado.hechos ?? []) {
        const casilla = raiz!.querySelector<HTMLInputElement>(`[data-hecho="${id}"]`);
        if (casilla) casilla.checked = true;
      }
      if (typeof guardado.indice === 'number') indice = guardado.indice;
    }

    // ── Navegación ──────────────────────────────────────────────────────────
    /**
     * En el salteado hay cuatro pasos seguidos con temporizador sobre la misma
     * sartén. Si no se limpian, la barra se llena de cuentas a cero de pasos
     * que ya has dejado atrás. Se van solos los que han terminado y quedan
     * detrás de donde estás; los que siguen corriendo se quedan, que es el
     * caso del horno del ramen.
     */
    function limpiarTerminados() {
      const ahora = Date.now();
      for (const timer of [...timers.values()]) {
        if (timer.finEn <= ahora && timer.pantalla < indice) {
          timers.delete(timer.pasoId);
          raiz!.querySelector(`[data-arrancar="${timer.pasoId}"]`)?.classList.remove('btn-play-activo');
        }
      }
    }

    function mostrar(i: number) {
      indice = Math.max(0, Math.min(total - 1, i));

      limpiarTerminados();

      pantallas.forEach(p => {
        p.hidden = Number(p.dataset.pantalla) !== indice;
      });

      // El resumen y el final no cuentan como pasos: «1 de 6» tiene que
      // coincidir con lo que ve el que cocina, no con el array.
      const pasos = total - 2;
      const enPaso = indice >= 1 && indice <= pasos;

      posicion.textContent = enPaso ? `${indice} de ${pasos}` : '';
      btnAnterior.hidden = indice === 0;
      btnSiguiente.hidden = indice === total - 1;
      nav?.classList.toggle('navegacion-inicio', indice === 0);

      segmentos.forEach(seg => {
        const n = Number(seg.dataset.segmento);
        seg.classList.toggle('segmento-hecho', n < indice);
        seg.classList.toggle('segmento-actual', n === indice);
      });

      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      pintarTimers();
      avisarPendientes();
      guardar();
    }

    const pendientes = raiz.querySelector<HTMLElement>('[data-pendientes]');
    const pendientesTexto = raiz.querySelector<HTMLElement>('[data-pendientes-texto]');

    function avisarPendientes() {
      if (!pendientes || !pendientesTexto) return;

      const enMarcha = [...timers.values()].filter(t => t.finEn > Date.now());
      const mostrarlo = indice === total - 1 && enMarcha.length > 0;

      pendientes.hidden = !mostrarlo;
      if (mostrarlo) {
        pendientesTexto.textContent =
          enMarcha.length === 1
            ? `Sigue corriendo el temporizador de «${enMarcha[0].etiqueta}».`
            : `Siguen corriendo ${enMarcha.length} temporizadores.`;
      }
    }

    raiz.querySelector('[data-parar-todo]')?.addEventListener('click', () => {
      for (const timer of timers.values()) {
        raiz!.querySelector(`[data-arrancar="${timer.pasoId}"]`)?.classList.remove('btn-play-activo');
      }
      timers.clear();
      pintarTimers();
      avisarPendientes();
      guardar();
    });

    btnAnterior.addEventListener('click', () => mostrar(indice - 1));
    btnSiguiente.addEventListener('click', () => mostrar(indice + 1));

    // Swipe como atajo, nunca como único camino: los botones siguen ahí.
    let inicioX = 0;
    let inicioY = 0;
    raiz.addEventListener('touchstart', e => {
      inicioX = e.changedTouches[0].clientX;
      inicioY = e.changedTouches[0].clientY;
    }, { passive: true });

    raiz.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - inicioX;
      const dy = e.changedTouches[0].clientY - inicioY;
      // Horizontal de verdad: si el dedo va en diagonal, es scroll.
      if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 2) {
        mostrar(indice + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

    // ── Sonido ──────────────────────────────────────────────────────────────
    // Generado, no un fichero: no hay que meter un binario en el repo y suena
    // igual sin conexión.
    let audio: AudioContext | null = null;

    function pitar() {
      try {
        audio ??= new AudioContext();
        if (audio.state === 'suspended') audio.resume();

        [0, 0.28, 0.56].forEach(retraso => {
          const osc = audio!.createOscillator();
          const vol = audio!.createGain();
          osc.connect(vol);
          vol.connect(audio!.destination);
          osc.frequency.value = 880;
          osc.type = 'triangle';
          const t = audio!.currentTime + retraso;
          vol.gain.setValueAtTime(0.0001, t);
          vol.gain.exponentialRampToValueAtTime(0.35, t + 0.02);
          vol.gain.exponentialRampToValueAtTime(0.0001, t + 0.2);
          osc.start(t);
          osc.stop(t + 0.22);
        });
      } catch {
        // Sin audio disponible nos queda la vibración y el aviso visual.
      }
    }

    // ── Temporizadores ──────────────────────────────────────────────────────
    function cuenta(segundos: number): string {
      const s = Math.max(0, Math.round(segundos));
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const seg = s % 60;
      const dosCifras = (n: number) => String(n).padStart(2, '0');
      return h > 0 ? `${h}:${dosCifras(m)}:${dosCifras(seg)}` : `${m}:${dosCifras(seg)}`;
    }

    function arrancar(boton: HTMLElement) {
      const pasoId = boton.dataset.arrancar!;
      const segundos = Number(boton.dataset.segundos);

      timers.set(pasoId, {
        pasoId,
        etiqueta: boton.dataset.etiqueta ?? '',
        finEn: Date.now() + segundos * 1000,
        duracion: segundos,
        pantalla: Number(boton.closest<HTMLElement>('[data-pantalla]')!.dataset.pantalla),
        avisado: false,
      });

      boton.classList.add('btn-play-activo');
      // El primer toque del usuario es la única ocasión de desbloquear el
      // audio en iOS. Si se espera al final del timer, no suena.
      audio ??= new AudioContext();
      audio.resume().catch(() => {});

      pintarTimers();
      guardar();
    }

    raiz.addEventListener('click', e => {
      const boton = (e.target as HTMLElement).closest<HTMLElement>('[data-arrancar]');
      if (boton) arrancar(boton);
    });

    function pintarTimers() {
      const ahora = Date.now();

      // El número gordo del paso deja de ser la duración y pasa a ser la
      // cuenta atrás en cuanto arrancas. Es la misma cifra, viva.
      for (const hueco of raiz!.querySelectorAll<HTMLElement>('[data-duracion-de]')) {
        const timer = timers.get(hueco.dataset.duracionDe!);
        if (!timer) {
          hueco.classList.remove('duracion-viva', 'duracion-fin');
          continue;
        }
        const restante = (timer.finEn - ahora) / 1000;
        hueco.textContent = restante <= 0 ? '¡ya!' : cuenta(restante);
        hueco.classList.add('duracion-viva');
        hueco.classList.toggle('duracion-fin', restante <= 0);
      }

      barra.hidden = timers.size === 0;
      if (timers.size === 0) return;

      barra.replaceChildren();

      for (const timer of timers.values()) {
        const restante = (timer.finEn - ahora) / 1000;
        const terminado = restante <= 0;

        const fila = document.createElement('div');
        fila.className = `timer ${terminado ? 'timer-fin' : ''}`;

        const ir = document.createElement('button');
        ir.type = 'button';
        ir.className = 'timer-ir';
        ir.innerHTML = `<span class="timer-etiqueta">${timer.etiqueta}</span><span class="timer-cuenta">${terminado ? '¡ya!' : cuenta(restante)}</span>`;
        ir.addEventListener('click', () => mostrar(timer.pantalla));

        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'timer-quitar';
        quitar.setAttribute('aria-label', `Quitar temporizador de ${timer.etiqueta}`);
        quitar.textContent = '×';
        quitar.addEventListener('click', () => {
          timers.delete(timer.pasoId);
          raiz!.querySelector(`[data-arrancar="${timer.pasoId}"]`)?.classList.remove('btn-play-activo');
          pintarTimers();
          guardar();
        });

        fila.append(ir, quitar);
        barra.append(fila);
      }
    }

    // Un solo interval para todos los timers, no uno por timer.
    setInterval(() => {
      if (timers.size === 0) return;

      const ahora = Date.now();
      let hayNuevoFin = false;

      for (const timer of timers.values()) {
        if (!timer.avisado && timer.finEn <= ahora) {
          timer.avisado = true;
          hayNuevoFin = true;
        }
      }

      if (hayNuevoFin) {
        pitar();
        navigator.vibrate?.([300, 120, 300, 120, 500]);
        guardar();
      }

      pintarTimers();
      avisarPendientes();
    }, 1000);

    // ── Pantalla encendida ──────────────────────────────────────────────────
    // Es lo que hace que los timers funcionen de verdad: con la pantalla
    // apagada el JavaScript se congela y no suena nada.
    let wakeLock: WakeLockSentinel | null = null;

    async function pedirWakeLock() {
      try {
        wakeLock = await navigator.wakeLock?.request('screen');
      } catch {
        // No está en todos los navegadores y su ausencia no rompe nada.
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      // iOS suelta el lock al cambiar de app y no lo devuelve solo.
      pedirWakeLock();
      // Y al volver, los timers se recalculan contra el reloj: los que
      // vencieron mientras la pestaña dormía se marcan y avisan ahora.
      pintarTimers();
    });

    raiz.addEventListener('change', e => {
      if ((e.target as HTMLElement).matches('[data-hecho]')) guardar();
    });

    window.addEventListener('pagehide', () => wakeLock?.release());

    // ── Tema ────────────────────────────────────────────────────────────────
    // El oscuro es el que manda: se cocina de noche y con la pantalla cerca de
    // la cara. El claro está para la cocina a mediodía con sol de frente.
    raiz.querySelector('[data-tema]')?.addEventListener('click', () => {
      const claro = document.documentElement.dataset.cocina === 'claro';
      const nuevo = claro ? 'oscuro' : 'claro';
      document.documentElement.dataset.cocina = nuevo;
      try {
        localStorage.setItem('cocina:tema', nuevo);
      } catch {
        // Sin localStorage el tema no se recuerda, pero funciona igual.
      }
    });

    restaurar();
    mostrar(indice);
    pintarTimers();
    pedirWakeLock();
  }
</script>

<style>
  /* ─────────────────────────────────────────────────────────────────────
     El modo cocina tiene identidad propia y no es un descuido: la web es
     un recetario que se hojea, y esto es una herramienta que se usa a
     medio metro, de noche, con las manos ocupadas. Sobre fondo crema, un
     móvil en la encimera deslumbra.

     Lo que se conserva del resto del sitio es la gramática: bordes
     gruesos, sombras duras, pasteles planos y la tipografía de píxeles
     para las cifras. Lo que cambia es el suelo, que pasa a ser oscuro y
     cálido.
     ───────────────────────────────────────────────────────────────────── */

  :global(html[data-cocina='oscuro']) {
    --fondo: #1C1A19;
    --superficie: #262322;
    --superficie-alta: #322E2C;
    --linea: #F4EFE2;
    --texto: #F4EFE2;
    --texto-tenue: #A39C90;
    --sombra: #000000;
    /* Sobre oscuro los pasteles del sitio dejan de ser fondo y pasan a ser
       señal: se usan en bloques pequeños y siempre con tinta encima. */
    --sobre-pastel: #1C1A19;
  }

  :global(html[data-cocina='claro']) {
    --fondo: #F9F3E3;
    --superficie: #FEFDFA;
    --superficie-alta: #FEFDFA;
    --linea: #382541;
    --texto: #382541;
    --texto-tenue: #6D5C75;
    --sombra: #382541;
    --sobre-pastel: #382541;
  }

  /* El layout pinta el body en crema. Aquí manda el tema, y con más
     especificidad para que no dependa del orden en que caigan los estilos. */
  :global(html[data-cocina] body) {
    background: var(--fondo);
    color: var(--texto);
  }

  .cocina {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--fondo);
    color: var(--texto);
  }

  /* ── Barra superior ────────────────────────────────────── */
  .barra-sup {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem 0.5rem;
  }

  .salir,
  .tema {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.875rem;
    font-family: var(--display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--texto);
    background: none;
    border: 2px solid var(--linea);
    border-radius: var(--r-pildora);
    text-decoration: none;
    cursor: pointer;
  }

  .tema { min-width: 44px; padding: 0; }
  .salir svg, .tema svg { width: 17px; height: 17px; }

  /* Un icono u otro según el tema: se enseña el destino, no el estado. */
  :global(html[data-cocina='oscuro']) .ico-luna { display: none; }
  :global(html[data-cocina='claro']) .ico-sol { display: none; }

  /* ── Progreso ──────────────────────────────────────────── */
  .progreso {
    display: flex;
    gap: 4px;
    padding: 0.5rem 1rem 1rem;
  }

  .segmento {
    flex: 1;
    height: 8px;
    background: var(--superficie-alta);
    border: 2px solid var(--linea);
    border-radius: var(--r-pildora);
  }

  .segmento-hecho { background: var(--menta); }
  .segmento-actual { background: var(--mantequilla); }

  /* ── Lienzo ────────────────────────────────────────────── */
  .lienzo {
    flex: 1;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 0.5rem 1.25rem 1rem;
  }

  .sobretitulo {
    font-family: var(--pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-tenue);
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .titulo-receta,
  .titulo-pantalla {
    font-family: var(--display);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
    text-align: center;
    text-wrap: balance;
  }

  .titulo-receta { font-size: 2.125rem; }
  /* Grande de verdad: esto se lee de pie y a distancia de brazo. */
  .titulo-pantalla { font-size: 2.5rem; }

  /* ── Aviso de reposo ───────────────────────────────────── */
  .aviso {
    background: var(--melocoton);
    color: var(--sobre-pastel);
    border: 3px solid var(--linea);
    border-radius: var(--r-tarjeta);
    box-shadow: 5px 5px 0 var(--sombra);
    padding: 1.125rem 1.25rem;
    margin-bottom: 1.75rem;
  }

  .aviso-titulo {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.0625rem;
    margin-bottom: 0.5rem;
  }

  .aviso ul { list-style: none; display: grid; gap: 0.35rem; }

  /* ── Bloques del resumen ───────────────────────────────── */
  .bloque {
    background: var(--superficie);
    border: 3px solid var(--linea);
    border-radius: var(--r-tarjeta);
    box-shadow: 5px 5px 0 var(--sombra);
    padding: 1.25rem 1.375rem;
    margin-bottom: 1.5rem;
  }

  .bloque h2 {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .bloque h3 {
    font-family: var(--pixel);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-tenue);
    margin: 1.25rem 0 0.5rem;
  }

  .lista-ing { list-style: none; display: grid; gap: 0.5rem; }

  .lista-ing li {
    font-size: 1.0625rem;
    line-height: 1.45;
    padding-left: 1.125rem;
    position: relative;
  }

  .lista-ing li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    background: var(--menta);
    border: 1.5px solid var(--linea);
  }

  /* ── Mise en place ─────────────────────────────────────── */
  .checklist { list-style: none; display: grid; gap: 0.875rem; }

  .checklist label {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    /* 44px de zona táctil mínima: se pulsa con el dedo, no con precisión. */
    min-height: 44px;
    background: var(--superficie);
    border: 3px solid var(--linea);
    border-radius: var(--r-caja);
    box-shadow: 4px 4px 0 var(--sombra);
    padding: 1rem 1.125rem;
    cursor: pointer;
  }

  .checklist input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .casilla {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-top: 0.1rem;
    background: var(--superficie-alta);
    border: 2.5px solid var(--linea);
    border-radius: 9px;
    color: transparent;
  }

  .casilla svg { width: 16px; height: 16px; }

  .checklist input:checked ~ .casilla {
    background: var(--menta);
    color: var(--sobre-pastel);
  }

  .checklist input:checked ~ .checklist-texto {
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .checklist input:focus-visible ~ .casilla {
    outline: 3px solid var(--mantequilla);
    outline-offset: 3px;
  }

  .checklist-texto { display: block; }

  .checklist-titulo {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.1875rem;
    margin-bottom: 0.25rem;
  }

  .checklist-texto :global(p) { font-size: 1rem; line-height: 1.5; }

  /* ── Ingredientes del paso ─────────────────────────────── */
  .ing-paso {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .ing-paso-bloque { margin: 0 0 1.5rem; }

  .chip-ing {
    display: inline-block;
    background: var(--cielo);
    color: var(--sobre-pastel);
    border: 2.5px solid var(--linea);
    border-radius: var(--r-pildora);
    padding: 0.3rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  /* ── Texto del paso ────────────────────────────────────── */
  .texto-paso { text-align: center; }

  .texto-paso :global(p) {
    font-size: 1.1875rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    color: var(--texto);
    text-wrap: pretty;
  }

  .texto-paso :global(strong) {
    font-weight: 800;
    color: var(--mantequilla);
  }

  /* ── Temporizador del paso ─────────────────────────────── */
  .zona-timer {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* La cifra manda. Píxeles porque es la voz que el sitio usa para los
     números, y tabular para que no baile al descontar. */
  .duracion {
    font-family: var(--pixel);
    font-size: 2.75rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--texto);
  }

  .duracion-viva { color: var(--menta); }

  .duracion-fin {
    color: var(--rosa);
    animation: latido 1s ease-in-out infinite;
  }

  .btn-play {
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    padding: 0;
    color: var(--sobre-pastel);
    background: var(--mantequilla);
    border: 3px solid var(--linea);
    border-radius: 50%;
    box-shadow: 5px 5px 0 var(--sombra);
    cursor: pointer;
  }

  .btn-play svg { width: 34px; height: 34px; margin-left: 3px; }

  .btn-play-activo { background: var(--menta); }

  .btn-play:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--sombra); }

  /* ── Reposo largo ──────────────────────────────────────── */
  .reposo-largo {
    background: var(--lavanda);
    color: var(--sobre-pastel);
    border: 3px solid var(--linea);
    border-radius: var(--r-caja);
    box-shadow: 5px 5px 0 var(--sombra);
    padding: 1.125rem 1.25rem;
    margin-top: 2rem;
    text-align: center;
  }

  .reposo-largo p { margin-bottom: 0.875rem; }

  .btn-atajo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.25rem;
    font-family: var(--display);
    font-weight: 800;
    color: var(--sobre-pastel);
    background: var(--superficie);
    border: 2.5px solid var(--linea);
    border-radius: var(--r-pildora);
    text-decoration: none;
    cursor: pointer;
  }

  /* ── Final ─────────────────────────────────────────────── */
  .pantalla-final { text-align: center; padding-top: 2.5rem; }

  .cierre-texto {
    font-size: 1.0625rem;
    margin-bottom: 1.75rem;
    color: var(--texto-tenue);
  }

  .pendientes {
    background: var(--rosa);
    color: var(--sobre-pastel);
    border: 3px solid var(--linea);
    border-radius: var(--r-caja);
    box-shadow: 4px 4px 0 var(--sombra);
    padding: 1.125rem 1.25rem;
    margin-bottom: 1.75rem;
  }

  .pendientes p { margin-bottom: 0.875rem; font-weight: 700; }

  .btn-volver {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 1.75rem;
    font-family: var(--display);
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--sobre-pastel);
    background: var(--menta);
    border: 3px solid var(--linea);
    border-radius: var(--r-pildora);
    box-shadow: 5px 5px 0 var(--sombra);
    text-decoration: none;
  }

  /* ── Barra de temporizadores ───────────────────────────── */
  .timers {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 1rem 0.25rem;
    background: var(--fondo);
  }

  /* Estas filas las crea el JavaScript, así que no llevan el atributo de
     scope de Astro y el CSS con scope no las alcanza. Van en :global,
     colgando de `.timers`, que sí es del template. */
  .timers :global(.timer) {
    display: flex;
    align-items: stretch;
    background: var(--cielo);
    color: var(--sobre-pastel);
    border: 3px solid var(--linea);
    border-radius: var(--r-pildora);
    overflow: hidden;
  }

  .timers :global(.timer-ir) {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0 0.5rem 0 1.125rem;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .timers :global(.timer-etiqueta) {
    font-family: var(--display);
    font-weight: 800;
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timers :global(.timer-cuenta) {
    font-family: var(--pixel);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .timers :global(.timer-quitar) {
    flex: 0 0 auto;
    width: 48px;
    background: none;
    border: none;
    border-left: 3px solid var(--linea);
    font-size: 1.5rem;
    line-height: 1;
    color: inherit;
    cursor: pointer;
  }

  /* Que se termine un timer no puede bloquear la cocina: avisa fuerte pero
     no tapa nada ni pide que lo cierres. */
  .timers :global(.timer-fin) { background: var(--rosa); animation: latido 1s ease-in-out infinite; }

  @keyframes latido {
    50% { opacity: 0.45; }
  }

  /* ── Navegación ────────────────────────────────────────── */
  .navegacion {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem calc(1rem + env(safe-area-inset-bottom));
    background: var(--fondo);
  }

  .nav-cuenta {
    font-family: var(--pixel);
    font-size: 0.8125rem;
    color: var(--texto-tenue);
    font-variant-numeric: tabular-nums;
  }

  .nav-circ {
    display: grid;
    place-items: center;
    /* 60px: se pulsa sin mirar y con el dedo torpe. */
    width: 60px;
    height: 60px;
    padding: 0;
    color: var(--texto);
    background: var(--superficie);
    border: 3px solid var(--linea);
    border-radius: 50%;
    cursor: pointer;
  }

  .nav-circ svg { width: 24px; height: 24px; }

  .nav-avanza {
    color: var(--sobre-pastel);
    background: var(--mantequilla);
    box-shadow: 4px 4px 0 var(--sombra);
  }

  .nav-circ:active { transform: translate(2px, 2px); box-shadow: none; }

  .nav-empezar { display: none; }

  /* En el resumen no hay «siguiente»: hay «empezar», y ocupa todo el ancho
     porque es la única cosa que se puede hacer en esa pantalla. */
  .navegacion-inicio { justify-content: stretch; }

  .navegacion-inicio .nav-avanza {
    flex: 1;
    width: auto;
    gap: 0.5rem;
    border-radius: var(--r-pildora);
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
    grid-auto-flow: column;
  }

  .navegacion-inicio .nav-empezar { display: inline; }

  @media (prefers-reduced-motion: reduce) {
    .timers :global(.timer-fin),
    .duracion-fin { animation: none; }
    .nav-circ:active,
    .btn-play:active { transform: none; }
  }
</style>

---
interface Props {
	title?: string;
}

const { title = 'Fork & Commit' } = Astro.props;

// BASE_URL llega sin barra final ('/fork-and-commit'), así que hay que
// normalizarla antes de concatenar o salen rutas como
// '/fork-and-commitfavicon.svg'.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}manifest.webmanifest`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Fork & Commit — Colección personal de recetas donde el código se encuentra con la cocina." />
		<meta name="theme-color" content="#F9F3E3" />

		<!-- Recetario personal: no hay ningún interés en salir en buscadores.
		     Se hace con la meta y no con un robots.txt porque robots.txt solo
		     se lee en la raíz del dominio (aquí sería pabloalejos.github.io,
		     no /fork-and-commit/), y porque Disallow impide rastrear pero no
		     indexar: el buscador no llegaría a leer este noindex.
		     Para permitir la indexación algún día, basta con quitar esta línea. -->
		<meta name="robots" content="noindex, nofollow" />

		<!-- Acceso directo en la pantalla de inicio de iOS -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Fork &amp; Commit" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@800&family=Nunito:wght@400;600;700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ══════════════════════════════════════════════════════════
	   Fork & Commit — reset y sistema de diseño
	   ══════════════════════════════════════════════════════════ */

	*,
	*::before,
	*::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	/* ── Tokens ────────────────────────────────────────────────
	   Los pasteles están definidos en oklch a L .885 / C .058:
	   misma luminosidad y croma, solo cambia el tono, así que
	   ninguno pesa más que otro. Cada uno tiene su versión honda
	   (sombras y bordes punteados) y su versión oscura (texto
	   encima del pastel). Cambia estos seis tonos y se recolorea
	   el sitio entero. */
	:root {
		/* Superficies */
		--crema: #F9F3E3;
		--blanco: #FEFDFA;

		/* Tinta — ciruela, nunca negro */
		--tinta: #382541;
		--tinta-suave: #6D5C75;

		/* Pasteles */
		--rosa: #FCCAD2;
		--melocoton: #F7D0B4;
		--mantequilla: #E4DAAE;
		--menta: #B9E6CC;
		--cielo: #B5E0FB;
		--lavanda: #DFD1FB;

		/* Pasteles hondos — sombra dura, bordes punteados */
		--rosa-hondo: #CD8894;
		--melocoton-hondo: #C79169;
		--mantequilla-hondo: #AE9F5F;
		--menta-hondo: #6DAF8C;
		--cielo-hondo: #68A7CC;
		--lavanda-hondo: #A693CC;

		/* Pasteles oscuros — texto sobre pastel */
		--rosa-ink: #793D49;
		--melocoton-ink: #75451D;
		--mantequilla-ink: #61520C;
		--menta-ink: #1C6142;
		--cielo-ink: #15597B;
		--lavanda-ink: #5A477A;

		/* Color activo de un bloque. Cada tarjeta o panel lo
		   reasigna en su style inline y todo lo de dentro hereda. */
		--pastel: var(--lavanda);
		--hondo: var(--lavanda-hondo);
		--ink: var(--lavanda-ink);

		/* Geometría */
		--borde: 3px solid var(--tinta);
		--borde-fino: 2.5px solid var(--tinta);
		--r-panel: 32px;
		--r-tarjeta: 26px;
		--r-caja: 18px;
		--r-pildora: 999px;

		/* Tipografía */
		--display: 'Bricolage Grotesque', 'Trebuchet MS', Verdana, sans-serif;
		--cuerpo: 'Nunito', 'Trebuchet MS', Verdana, sans-serif;
		--pixel: 'Silkscreen', ui-monospace, 'Courier New', monospace;

		/* Tramas decorativas */
		--trama-puntos: radial-gradient(rgba(56, 37, 65, 0.16) 2px, transparent 2.2px);
		--trama-cuadricula: repeating-linear-gradient(0deg, rgba(56, 37, 65, 0.13) 0 1.5px, transparent 1.5px 22px), repeating-linear-gradient(90deg, rgba(56, 37, 65, 0.13) 0 1.5px, transparent 1.5px 22px);
		--trama-rayas: repeating-linear-gradient(45deg, rgba(56, 37, 65, 0.10) 0 8px, transparent 8px 20px);
		--trama-ondas: repeating-radial-gradient(circle at 50% 120%, transparent 0 16px, rgba(56, 37, 65, 0.10) 16px 19px);
	}

	/* ── Base ──────────────────────────────────────────────── */
	html {
		font-family: var(--cuerpo);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		overflow-x: clip;
		background-color: var(--crema);
		background-image: var(--trama-puntos);
		background-size: 15px 15px;
		color: var(--tinta);
		line-height: 1.6;
		min-height: 100vh;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--display);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	a {
		color: var(--ink);
		text-decoration: none;
	}

	a:hover {
		color: var(--tinta);
	}

	img {
		display: block;
		max-width: 100%;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	/* ── Etiquetas ─────────────────────────────────────────────
	   Píldoras pastel. Heredan --pastel/--hondo/--ink del bloque
	   que las contiene, así que la misma clase se pinta distinta
	   en cada tarjeta sin una sola regla extra. */
	.tag {
		display: inline-block;
		background: var(--pastel);
		color: var(--ink);
		border: 2px solid var(--tinta);
		border-radius: var(--r-pildora);
		padding: 4px 11px;
		font-family: var(--cuerpo);
		font-weight: 700;
		font-size: 0.72rem;
		line-height: 1.5;
		cursor: default;
		text-decoration: none;
	}

	.tag-clickable,
	.tag-link {
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.tag-clickable:hover,
	.tag-link:hover {
		transform: translate(-1px, -1px);
		box-shadow: 3px 3px 0 var(--hondo);
		color: var(--ink);
	}

	.tag-clickable.active {
		background: var(--tinta);
		color: var(--crema);
		box-shadow: 3px 3px 0 var(--hondo);
	}

	.tag-more {
		display: inline-block;
		background: var(--blanco);
		color: var(--tinta);
		border: 2px solid var(--tinta);
		border-radius: var(--r-pildora);
		padding: 4px 11px;
		font-family: var(--pixel);
		font-size: 0.62rem;
		line-height: 1.7;
	}

	/* ── Accesibilidad ─────────────────────────────────────── */
	:focus-visible {
		outline: 3px solid var(--tinta);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

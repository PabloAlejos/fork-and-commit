# URL del backend del gestor de recetas (fork-and-commit-recipe-manager).
#
# Se inyecta en el cliente en tiempo de build, así que NO es un secreto: es
# solo una dirección. La clave de administración la escribe el usuario en la
# propia página y se guarda en su navegador, nunca aquí.
#
#   Backend en la misma máquina que el navegador   http://localhost:8000
#   Backend en otro PC de la red local             http://192.168.1.50:8000
#   Backend tras Tailscale / Cloudflare Tunnel     https://recetas.tu-dominio
#
# Ojo: una página servida por HTTPS (GitHub Pages) solo puede llamar a https://
# o a localhost. Ver la sección "Admin" del README.
#
# Esto es solo para desarrollo. Lo que se publica lo fija el paso de build de
# .github/workflows/deploy.yml, porque este fichero está en el .gitignore y CI
# no lo ve.
PUBLIC_API_URL=http://localhost:8000
